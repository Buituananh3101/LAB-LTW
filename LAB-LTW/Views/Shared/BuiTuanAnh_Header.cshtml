<!-- Begin Header: BuiTuanAnh_Header -->
<div class="header">
    <div class="header_top">
        <div class="logo">
            <a asp-controller="Home" asp-action="Index"><img src="~/images/logo.png" alt="" /></a>
        </div>
        <div class="cart">
            <p>Welcome to our Online Store! <span>Cart:</span><div id="dd" class="wrapper-dropdown-2"> 0 item(s) - $0.00
                <ul class="dropdown">
                    <li>you have no items in your Shopping cart</li>
                </ul></div>
            </p>
        </div>		
        <div class="clear"></div>
    </div>
    <div class="header_bottom">
        <div class="menu">
            <!-- Câu 2: Load dữ liệu từ bảng LoaiHang lên thanh điều hướng, thay thế menu Home bằng họ tên SV -->
            @await Component.InvokeAsync("Navbar")
        </div>
        <div class="search_box">
            <form onsubmit="return false;">
                <input type="text" value="Search" onfocus="this.value = '';" onblur="if (this.value == '') {this.value = 'Search';}">
                <input type="button" value="">
            </form>
        </div>
        <div class="clear"></div>
    </div>	     
</div>
<!-- End Header: BuiTuanAnh_Header -->
