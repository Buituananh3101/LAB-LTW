@inject LAB_LTW.Models.LTWQLHangHoaContext db

<!-- 1.1.1: Tách Header theo quy định BuiTuanAnh_Header (Views/Shared/BuiTuanAnh_Footer.cshtml - 1) -->
<div class="header">
    <div class="header_top">
        <div class="logo">
            <a href="/"><img src="~/images/logo.png" alt="" /></a>
        </div>
        <div class="cart">
            <p>Welcome to our Online Store! <span>Cart:</span><div id="dd" class="wrapper-dropdown-2"> 0 item(s) - $0.00
                <ul class="dropdown"><li>you have no items in your Shopping cart</li></ul></div>
            </p>
        </div>		
        <div class="clear"></div>
    </div>
    <div class="header_bottom">
        <div class="menu">
            <ul>
                <!-- 2.2.2: Menu Home thay bằng họ tên sinh viên BÙI TUẤN ANH (x - 24) -->
                <li class="active nav-item-category" data-maloai="0">
                    <a href="javascript:void(0);">BÙI TUẤN ANH</a>
                </li>

                <!-- 2.2.3: Load LoaiHang từ CSDL lên menu điều hướng (Controllers/HomeController.cs - 16) -->
                @foreach (var item in db.LoaiHangs)
                {
                    <li class="nav-item-category" data-maloai="@item.MaLoai">
                        <a href="javascript:void(0);">@item.TenLoai</a>
                    </li>
                }
                <div class="clear"></div>
            </ul>
        </div>
        <div class="search_box">
            <form onsubmit="return false;">
                <input type="text" value="Search" onfocus="this.value = '';" onblur="if (this.value == '') {this.value = 'Search';}">
                <input type="button" value="">
            </form>
        </div>
        <div class="clear"></div>
    </div>	     
</div>
