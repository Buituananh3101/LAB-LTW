<!DOCTYPE HTML>
<html>
<head>
    <title>BuiTuanAnh_241230653</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    
    <!-- 1.2.1: Ghép CSS từ wwwroot -->
    <link href="~/css/style.css" rel="stylesheet" type="text/css" media="all" />
</head>
<body>
    <div class="wrap">
        <!-- 1.1.1: Render Header -->
        @await Html.PartialAsync("BuiTuanAnh_Header")

        <div class="main">
            <!-- 1.1.4: Render Body -->
            @RenderBody()
        </div>
    </div>

    <!-- 1.1.2: Render Footer -->
    @await Html.PartialAsync("BuiTuanAnh_Footer")

    <!-- 1.2.2: Thư viện jQuery -->
    <script src="~/js/jquery-1.7.2.min.js"></script>

    <!-- 4.1.2: AJAX lọc danh sách hàng hóa ngắn nhất -->
    <script>
        $(document).on('click', '.nav-item-category', function (e) {
            e.preventDefault();
            $('.nav-item-category').removeClass('active');
            $(this).addClass('active');

            var id = $(this).data('maloai');
            $.get('/Home/GetHangHoaByLoai', { maloai: id }, function (data) {
                $('#mainContent').html(data);
            });
        });
    </script>
</body>
</html>
