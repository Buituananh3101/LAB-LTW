@model IEnumerable<LAB_LTW.Models.HangHoa>

<!-- 1.1.3: Tách MainContent theo quy định BuiTuanAnh_MainContent (Views/_ViewStart.cshtml - 2) -->
<div class="content_top">
    <div class="heading">
        <!-- 3.1.2: Tiêu đề thay bằng tên SV: BÙI TUẤN ANH (x - 16) -->
        <h3>BÙI TUẤN ANH</h3>
    </div>
    <div class="see">
        <p><a asp-controller="Home" asp-action="Create">+ Thêm Hàng Hóa Mới</a></p>
    </div>
    <div class="clear"></div>
</div>

<div class="section group">
    <!-- 3.1.3: Render danh sách sản phẩm giá >= 100 (Controllers/HomeController.cs - 23) -->
    @foreach (var item in Model)
    {
        <div class="grid_1_of_4 images_1_of_4">
            <a href="#"><img src="~/images/@item.Anh" alt="" /></a>
            <h2>@item.TenHang</h2>
            <div class="price-details">
                <div class="price-number">
                    <p><span class="rupees">@item.Gia</span></p>
                </div>
                <div class="add-cart">								
                    <h4><a href="#">Add to Cart</a></h4>
                </div>
                <div class="clear"></div>
            </div>					 
        </div>
    }
</div>
