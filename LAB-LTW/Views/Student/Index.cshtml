@{
    ViewData["Title"] = "Danh sách sinh viên";
    // Layout = "~/Views/Shared/MyLayout.cshtml";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}

@model IEnumerable<Student>

@* Đây là đường dẫn giả nút :)) ko phải nút thật
   --> Bấm nút sẽ mở action GET Create của controller hiện tại
    
   Vì 2 lí do:
   1: 
   <a> là liên kết 
   --> Khi bạn bấm vào, trình duyệt mặc định gửi yêu cầu GET để mở địa chỉ của liên kết
   2:
   không ghi thuộc tính HTTP mặc định là GET
*@

@* <a asp-action="Create" class="btn btn-primary">Create Student</a> ---------> chưa sửa route*@

<div class="mb-3"> <a asp-route="StudentAdd" class="btn btn-primary">Create Student</a> </div> @*Thêm khối div để nút nó ko kéo dài full trang*@


@* 
Cách 1: HTML thuần 
<a href="/Admin/Student/Add" class="btn btn-primary">Create Student</a>

Cách 2: Gọi action theo tên 
<a asp-controller="Student" asp-action="Create" class="btn btn-primary">Create Student</a>

Cách 3: Gọi route theo tên 
<a asp-route="StudentAdd" class="btn btn-primary">Create Student</a>
*@

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ảnh</th>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ ĐT</th>
            <th>Địa chỉ</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var s in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(s.AvatarUrl))
                    {
                        <img src="@s.AvatarUrl" alt="Ảnh của @s.Name" width="60" height="60" />
                    }
                </td>

                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.DateOfBorth</td>

                @{
                    string str = "";
                    switch(s.Branch)
                    {
                        case Branch.IT: str= "CNTT";           break;
                        case Branch.BE: str= "Kinh tế";        break;
                        case Branch.CE: str = "Công trình";    break;
                        case Branch.EE: str = "Điện - Điện tử";break;
                    }
                }
                <td>@str</td>

                <td>@(s.Gender==Gender.Male? "Nam": "Nữ")</td>
                <td>@(s.IsRegular ? "Chính quy": "Phi chính quy")</td>
                <td>@s.Address</td>
                <td>@s.Email</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts
{
    <script>
        // Lấy bảng đầu tiên trong trang.
        var table = document.querySelector("table");

        // Khi bấm vào bảng, đổi nền thành màu vàng.
        table.onclick = function onTableClick() {
            table.style.backgroundColor = "yellow";
        };
    </script>
}