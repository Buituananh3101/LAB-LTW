@model LAB_LTW.Models.HangHoa

<!-- 5.1.2: Form Thêm Hàng Hóa mới theo mẫu đề thi (Controllers/HomeController.cs - 39) -->
<div class="content" style="padding: 20px 0;">
    <h2>Bùi Tuấn Anh</h2>
    <h3>Thêm Hàng Hóa Mới</h3>

    <form asp-action="Create" method="post">
        <div style="margin-bottom: 10px;">
            <label>MaLoai</label><br />
            <select asp-for="MaLoai" asp-items="ViewBag.MaLoai"></select>
        </div>

        <div style="margin-bottom: 10px;">
            <label>TenHang</label><br />
            <input asp-for="TenHang" />
            <span asp-validation-for="TenHang" style="color:red"></span>
        </div>

        <div style="margin-bottom: 10px;">
            <label>Gia</label><br />
            <input asp-for="Gia" />
            <span asp-validation-for="Gia" style="color:red"></span>
        </div>

        <div style="margin-bottom: 10px;">
            <label>Anh</label><br />
            <input asp-for="Anh" />
            <span asp-validation-for="Anh" style="color:red"></span>
        </div>

        <div style="margin-top: 15px;">
            <input type="submit" value="Create" />
            <a asp-action="Index" style="margin-left: 10px;">Quay lại</a>
        </div>
    </form>
</div>
